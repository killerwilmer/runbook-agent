# Proveedor: groq | gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2

GROQ_API_KEY=tu_clave_aqui
GEMINI_API_KEY=tu_clave_aqui

LOG_LEVEL=INFO

# Precio en USD por millón de tokens (búscalo en la página de precios del proveedor).
# Aunque uses la capa gratuita, ponlo para simular el costo real en producción.
INPUT_COST_PER_1M_TOKENS=0.15
OUTPUT_COST_PER_1M_TOKENS=0.60
